[Unit]
Description=multiclaude router: routes each message to its person's assistant and runs the bot's commands
After=assistant.service network-online.target
PartOf=assistant.service

[Service]
Type=simple
User={{USER}}
Environment=HOME={{HOME}}
# As bin/common.sh: the claude commands it runs start MCP servers from these (uv, uvx, bun).
Environment=PATH={{HOME}}/.local/bin:{{HOME}}/.bun/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory={{ROOT}}
ExecStart={{PYTHON}} -I {{ROOT}}/bin/watcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=assistant.service
